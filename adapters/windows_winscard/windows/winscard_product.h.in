#ifndef DTV_USERLAND_WINDOWS_WINSCARD_PRODUCT_H
#define DTV_USERLAND_WINDOWS_WINSCARD_PRODUCT_H

// Generated from the product's explicit configuration.  There is deliberately
// no default: a product that enables the adapter must supply every value and
// is never silently given the PX4 identity.

namespace px4::userland::windows_card {

// Runtime layout <runtime>/<namespace>/<version>/<instance>.
inline constexpr char kProductNamespace[] =
    "@DTV_WINDOWS_WINSCARD_NAMESPACE_COMPONENT@";
inline constexpr wchar_t kProductNamespaceW[] =
    L"@DTV_WINDOWS_WINSCARD_NAMESPACE_COMPONENT@";
inline constexpr char kProductVersion[] =
    "@DTV_WINDOWS_WINSCARD_VERSION_COMPONENT@";
inline constexpr wchar_t kProductVersionW[] =
    L"@DTV_WINDOWS_WINSCARD_VERSION_COMPONENT@";

// Canonical UDTV LIST producer.product value.  The client requires it before
// exposing a reader or issuing CARD_STATUS/CARD_CONNECT.
inline constexpr char kProductSlug[] =
    "@DTV_WINDOWS_WINSCARD_PRODUCT_SLUG@";

// Shared by the client's reader display names and the proxy's prefix test.
inline constexpr char kReaderPrefix[] =
    "@DTV_WINDOWS_WINSCARD_READER_PREFIX@";

// Optional runtime-root override, read once when a context is established.
inline constexpr wchar_t kRuntimeEnv[] =
    L"@DTV_WINDOWS_WINSCARD_RUNTIME_ENV@";

}  // namespace px4::userland::windows_card

#endif  // DTV_USERLAND_WINDOWS_WINSCARD_PRODUCT_H
