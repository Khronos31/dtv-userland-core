@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_coreTargets.cmake")
# Optional component: the internal receiver engine and its Threads dependency.
foreach(_dtv_userland_component IN LISTS dtv_userland_core_FIND_COMPONENTS)
    if(_dtv_userland_component STREQUAL "receiver" AND
       EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        set(dtv_userland_core_receiver_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "card" AND TARGET dtv::card)
        set(dtv_userland_core_card_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "capture" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_captureTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_captureTargets.cmake")
        set(dtv_userland_core_capture_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "control" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        set(dtv_userland_core_control_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "status_projection" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_status_projectionTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
            include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        endif()
        if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
            include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        endif()
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_status_projectionTargets.cmake")
        set(dtv_userland_core_status_projection_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "authority" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_authorityTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_status_projectionTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_authorityTargets.cmake")
        set(dtv_userland_core_authority_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "host_tuner" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_tunerTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_tunerTargets.cmake")
        set(dtv_userland_core_host_tuner_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "host_workers" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_workersTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_status_projectionTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_authorityTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_tunerTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_workersTargets.cmake")
        set(dtv_userland_core_host_workers_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "host_authority_owner" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_authority_ownerTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_status_projectionTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_authorityTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_tunerTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_authority_ownerTargets.cmake")
        set(dtv_userland_core_host_authority_owner_FOUND TRUE)
    elseif(_dtv_userland_component STREQUAL "host_authority_bridge" AND
           EXISTS "${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_authority_bridgeTargets.cmake")
        include(CMakeFindDependencyMacro)
        find_dependency(Threads)
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_receiverTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_controlTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_status_projectionTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_authorityTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_tunerTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_authority_ownerTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_workersTargets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/dtv_userland_host_authority_bridgeTargets.cmake")
        set(dtv_userland_core_host_authority_bridge_FOUND TRUE)
    else()
        set(dtv_userland_core_${_dtv_userland_component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(dtv_userland_core)
